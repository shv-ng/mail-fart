{
  "manifest_version": 3,
  "name": "Mail Fart",
  "version": "0.0.1",
  "description": "Play custom sound effects when keywords appear in Gmail messages.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

"permissions": [
  "storage",
  "unlimitedStorage",
  "scripting",
  "activeTab",
  "tabs"
],

  "host_permissions": [
    "https://mail.google.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
